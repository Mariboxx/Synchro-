        // Formátování českého data (např. "3. – 6. 12. 2026")
        function formatDateRange(startStr, endStr) {
            const start = new Date(startStr + 'T00:00:00');
            const end = new Date(endStr + 'T00:00:00');

            const sDay = start.getDate();
            const sMonth = start.getMonth() + 1;
            const sYear = start.getFullYear();

            const eDay = end.getDate();
            const eMonth = end.getMonth() + 1;
            const eYear = end.getFullYear();

            if (startStr === endStr) {
                return `${sDay}. ${sMonth}. ${sYear}`;
            }
            if (sMonth === eMonth && sYear === eYear) {
                return `${sDay}. – ${eDay}. ${eMonth}. ${eYear}`;
            }
            return `${sDay}. ${sMonth}. – ${eDay}. ${eMonth}. ${eYear}`;
        }

        // Výpočet rozdílu dnů od referenčního data
        function getDaysDiff(startStr, endStr) {
            const today = new Date(CURRENT_DATE.getFullYear(), CURRENT_DATE.getMonth(), CURRENT_DATE.getDate());
            const start = new Date(startStr + 'T00:00:00');
            const end = new Date(endStr + 'T23:59:59');

            if (CURRENT_DATE >= start && CURRENT_DATE <= end) {
                return { status: 'ONGOING', days: 0 };
            }
            if (CURRENT_DATE > end) {
                return { status: 'PAST', days: -1 };
            }
            const diffTime = start - today;
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            return { status: 'UPCOMING', days: diffDays };
        }

        // Aktualizace horního odpočítávacího banneru
        function updateCountdownBanner() {
            const upcoming = state.competitions
                .filter(c => new Date(c.endDate + 'T23:59:59') >= CURRENT_DATE)
                .sort((a, b) => new Date(a.startDate) - new Date(b.startDate));

            const bannerTitle = document.getElementById('next-comp-title');
            const bannerMeta = document.getElementById('next-comp-meta');

            if (upcoming.length === 0) {
                bannerTitle.textContent = 'Sezóna 2026/2027 je u konce';
                bannerMeta.textContent = 'Všechny naplánované závody již proběhly.';
                document.getElementById('cd-days').textContent = '0';
                document.getElementById('cd-hours').textContent = '0';
                document.getElementById('cd-mins').textContent = '0';
                return;
            }

            const next = upcoming[0];
            bannerTitle.textContent = next.name;
            bannerMeta.innerHTML = `
                <span>📅 ${formatDateRange(next.startDate, next.endDate)}</span>
                <span>•</span>
                <span>📍 ${next.city} (${next.country})</span>
            `;

            const targetTime = new Date(next.startDate + 'T09:00:00');
            const diffMs = Math.max(0, targetTime - CURRENT_DATE);

            const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diffMs / (1000 * 60 * 60)) % 24);
            const mins = Math.floor((diffMs / (1000 * 60)) % 60);

            document.getElementById('cd-days').textContent = String(days).padStart(2, '0');
            document.getElementById('cd-hours').textContent = String(hours).padStart(2, '0');
            document.getElementById('cd-mins').textContent = String(mins).padStart(2, '0');
        }

        // Vykreslení seznamu závodů
