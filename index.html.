        // Přidání nového závodu z formuláře
        function handleAddCompetition(e) {
            e.preventDefault();
            const name = document.getElementById('new-name').value.trim();
            const startDate = document.getElementById('new-start').value;
            const endDate = document.getElementById('new-end').value;
            const city = document.getElementById('new-city').value.trim();
            const country = document.getElementById('new-country').value.trim();
            const category = document.getElementById('new-category').value;
            const note = document.getElementById('new-note').value.trim();

            if (!name || !startDate || !endDate || !city) return;

            const newComp = {
                id: 'custom-' + Date.now(),
                name,
                startDate,
                endDate: endDate < startDate ? startDate : endDate,
                city,
                country,
                category,
                source: 'Vlastní záznam',
                note: note || 'Ručně přidaný závod do osobního kalendáře.',
                url: ''
            };

            state.competitions.push(newComp);
            state.favorites.push(newComp.id);
            saveState();

            closeAddModal();
            document.getElementById('add-comp-form').reset();
            updateCountdownBanner();
            renderCompetitions();
            showToast('Nový závod byl úspěšně přidán!');
