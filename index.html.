    <style>
        /* Ledové pozadí a skleněný efekt (Frosted Glass) */
        body {
            background: radial-gradient(circle at top right, #0f294a 0%, #071326 45%, #040812 100%);
            min-height: 100vh;
            color: #f8fafc;
        }

        .glass-panel {
            background: rgba(15, 31, 56, 0.55);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(125, 211, 252, 0.16);
        }

        .glass-card {
            background: linear-gradient(145deg, rgba(20, 40, 72, 0.65) 0%, rgba(10, 22, 42, 0.75) 100%);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(186, 230, 253, 0.14);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.45);
            box-shadow: 0 12px 28px -8px rgba(2, 132, 199, 0.28);
        }

        .ice-glow {
            box-shadow: 0 0 35px -5px rgba(56, 189, 248, 0.25);
        }

        /* Skrytí scrollbaru u horizontálních filtrů na mobilu */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        @keyframes pulse-ice {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.55; }
        }
        .animate-pulse-ice {
            animation: pulse-ice 2s infinite ease-in-out;
        }
    </style>
</head>
