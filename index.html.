        // Simulace synchronizace z online zdrojů (ISU, SynchroCenter, ČKS)
        function triggerSync() {
            const icon = document.getElementById('sync-icon');
            const syncText = document.getElementById('last-sync-text');
            icon.classList.add('animate-spin');

            showToast('Stahuji aktuální termíny Advanced Novice z ISU a ČKS...');

            setTimeout(() => {
                icon.classList.remove('animate-spin');
                const now = new Date();
                const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
                syncText.textContent = `Kategorie Advanced Novice (ISU & ČR) • Synchronizováno v ${timeStr}`;
                showToast('Kalendář Advanced Novice je aktuální ✓');
            }, 1100);
        }

