            const container = document.getElementById('competitions-list');
            const emptyState = document.getElementById('empty-state');
            const countLabel = document.getElementById('results-count');

            // Filtrování a seřazení podle data
            const filtered = state.competitions
                .filter(comp => {
                    const timing = getDaysDiff(comp.startDate, comp.endDate);
                    if (state.hidePast && timing.status === 'PAST') return false;
                    if (state.onlyFavorites && !state.favorites.includes(comp.id)) return false;
                    if (state.selectedCategory !== 'ALL' && comp.category !== state.selectedCategory) return false;
                    if (state.searchQuery) {
                        const haystack = `${comp.name} ${comp.city} ${comp.country} ${comp.note || ''}`.toLowerCase();
                        if (!haystack.includes(state.searchQuery)) return false;
                    }
                    return true;
                })
                .sort((a, b) => new Date(a.startDate) - new Date(b.startDate));

            countLabel.textContent = `Zobrazeno ${filtered.length} ${getCzechPlural(filtered.length, 'závod', 'závody', 'závodů')}`;

            if (filtered.length === 0) {
                container.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            container.innerHTML = filtered.map(comp => createCompetitionCardHTML(comp)).join('');
        }

